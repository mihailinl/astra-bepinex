<Project Sdk="Microsoft.NET.Sdk">
  <!-- Astra for AstraTestbed: a game integration on the Astra Unity foundation.
       The foundation is installed in the game once and updates by itself, so it is referenced
       COMPILE-ONLY here (ExcludeAssets="runtime") and never shipped with this plugin. The game's own
       assemblies are referenced from its install folder, also never shipped: set GameDir below,
       on the command line (-p:GameDir=…) or in GameDir.props.user (ignored by git). -->
  <PropertyGroup>
    <!-- Unity 2021.2+ (netstandard2.1). A game on Unity 2021.1 or older: netstandard2.0. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AstraRuntime>unity-mono</AstraRuntime>
    <AstraLoader>bepinex5</AstraLoader>
    <AssemblyName>TestbedIntegration</AssemblyName>
    <RootNamespace>TestbedIntegration</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <BepInExPluginGuid>astra.testbed</BepInExPluginGuid>
    <BepInExPluginName>Astra for AstraTestbed</BepInExPluginName>
    <Version>0.1.0</Version>
    <SteamAppId>0</SteamAppId>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <Import Project="GameDir.props.user" Condition="Exists('GameDir.props.user')" />
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''"></GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Astra.Unity.Sdk" Version="0.2.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
  </ItemGroup>

  <!-- The game's Unity and code assemblies, compile-only. -->
  <ItemGroup Condition="'$(GameDir)' != ''">
    <!-- Every managed assembly of the game (its classes derive from its libraries' — Photon,
         Mirror…), but not the .NET ones the SDK brings. -->
    <Reference Include="$(GameDir)/*_Data/Managed/*.dll"
               Exclude="$(GameDir)/*_Data/Managed/mscorlib.dll;$(GameDir)/*_Data/Managed/netstandard.dll;$(GameDir)/*_Data/Managed/System*.dll;$(GameDir)/*_Data/Managed/Mono.*.dll;$(GameDir)/*_Data/Managed/Microsoft.*.dll"
               Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameDir)' == ''">
    <!-- No game folder: Unity's API alone (code that names the game's own types needs GameDir). -->
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <!-- The installed-version marker the Astra client reads, beside the plugin. -->
  <Target Name="AstraItemMarker" AfterTargets="Build">
    <WriteLinesToFile File="$(OutDir)astra-item.json" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="{&quot;id&quot;:&quot;$(BepInExPluginGuid)&quot;,&quot;version&quot;:&quot;$(Version)&quot;,&quot;kind&quot;:&quot;game-integration&quot;,&quot;runtime&quot;:&quot;$(AstraRuntime)&quot;,&quot;loader&quot;:&quot;$(AstraLoader)&quot;,&quot;steam_appid&quot;:$(SteamAppId)}" />
  </Target>
</Project>
