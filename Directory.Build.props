<Project>
  <!-- Shared by every project. C# 9 compiles to IL any Unity runtime runs (no records / init:
       those need runtime types an old Mono lacks). -->
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>mihailinl and the astra-bepinex contributors</Authors>
    <!-- The foundation's and its SDK's version (the plugins' BepInEx version, which BepInEx parses as
         a plain x.y.z: never a suffix here). A pack that is not a release still gets a prerelease
         PACKAGE version (-dev, -mono-dev: src/Astra.Unity.Sdk, templates/), so a local pack never
         shares an id and a version with a published package in anyone's NuGet cache. -->
    <Version>0.8.0</Version>
  </PropertyGroup>
</Project>
