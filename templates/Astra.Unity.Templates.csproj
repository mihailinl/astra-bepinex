<Project Sdk="Microsoft.NET.Sdk">
  <!-- `dotnet new install Astra.Unity.Templates` → `dotnet new astra-integration`. -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Astra.Unity.Templates</PackageId>
    <Title>Astra game integration templates</Title>
    <Description>dotnet new astra-integration: a BepInEx plugin that makes Astra better in one Unity game (Mono or IL2CPP).</Description>
    <PackageTags>astra;bepinex;unity;mod;template</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../artifacts/nuget</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="astra-integration/**/*" Exclude="astra-integration/**/bin/**;astra-integration/**/obj/**" />
    <Compile Remove="**/*" />
  </ItemGroup>
</Project>
