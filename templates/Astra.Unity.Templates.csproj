<Project Sdk="Microsoft.NET.Sdk">
  <!-- The astra-integration template as a package (tools/pack.sh writes it to artifacts/nuget):
       `dotnet new install artifacts/nuget/Astra.Unity.Templates.<version>.nupkg`, or straight from a
       clone, `dotnet new install templates/astra-integration`; then `dotnet new astra-integration`.
       Neither the templates nor the SDK are on nuget.org. -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Astra.Unity.Templates</PackageId>
    <Title>Astra game integration templates</Title>
    <Description>dotnet new astra-integration: a BepInEx plugin that makes Astra better in one Unity game (Mono or IL2CPP).</Description>
    <PackageTags>astra;bepinex;unity;mod;template</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../artifacts/nuget</PackageOutputPath>
    <!-- Not a release (AstraRelease=true, tools/pack.sh under ASTRA_PACK_REQUIRE=all): a prerelease
         package version, never the one a published package has. -->
    <PackageVersion Condition="'$(AstraRelease)' != 'true'">$(Version)-dev</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="astra-integration/**/*" Exclude="astra-integration/**/bin/**;astra-integration/**/obj/**" />
    <Compile Remove="**/*" />
  </ItemGroup>
</Project>
