<?xml version="1.0" encoding="utf-8"?>
<!-- Where packages come from: nuget.org, BepInEx's feed, and nuget-local/ — the Astra SDK, which is
     not on nuget.org: tools/fetch.sh puts the pinned one there (a relative path here is relative
     to this file). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
    <add key="astra-local" value="nuget-local" />
  </packageSources>
</configuration>
