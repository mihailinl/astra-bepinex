{
  "$schema": "http://json.schemastore.org/template",
  "author": "Astra",
  "classifications": [
    "Astra",
    "BepInEx",
    "Unity",
    "Mod"
  ],
  "identity": "Astra.Unity.Integration",
  "name": "Astra game integration (BepInEx)",
  "shortName": "astra-integration",
  "sourceName": "AstraIntegration",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "game": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "replaces": "GAME_NAME",
      "description": "The game's name as players know it (\"PEAK\")."
    },
    "id": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "astra.integration-id",
      "defaultValue": "astra.my-game",
      "description": "The integration's id: its BepInEx GUID and its marketplace id (\"astra.peak\")."
    },
    "runtime": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "mono",
      "choices": [
        {
          "choice": "mono",
          "description": "A Mono game (<Game>_Data/Managed/Assembly-CSharp.dll exists): BepInEx 5."
        },
        {
          "choice": "il2cpp",
          "description": "An IL2CPP game (GameAssembly.dll exists): BepInEx 6."
        }
      ]
    },
    "steamAppId": {
      "type": "parameter",
      "datatype": "integer",
      "isRequired": true,
      "replaces": "0000000",
      "description": "The game's Steam app id (its store page URL has it). Astra keys the game's profile on it."
    },
    "gameDir": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "GAME_DIR_PATH",
      "defaultValue": "",
      "description": "Where the game is installed (its assemblies are referenced to compile, never shipped)."
    },
    "owner": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "GITHUB_OWNER",
      "defaultValue": "your-github-name",
      "description": "The GitHub user or organisation that will own this repository: its address in astra-gi.toml, the author and the LICENSE's copyright."
    },
    "exe": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "The game's executable, relative to its folder (default: <game>.exe)."
    },
    "mono": {
      "type": "computed",
      "value": "(runtime == \"mono\")"
    },
    "runtimeName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "RUNTIME_NAME",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(runtime == 'mono')",
            "value": "unity-mono"
          },
          {
            "condition": "(runtime == 'il2cpp')",
            "value": "unity-il2cpp"
          }
        ]
      }
    },
    "loaderName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "LOADER_NAME",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(runtime == 'mono')",
            "value": "bepinex5"
          },
          {
            "condition": "(runtime == 'il2cpp')",
            "value": "bepinex6"
          }
        ]
      }
    },
    "exeDefault": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "game"
          },
          {
            "type": "const",
            "value": ".exe"
          }
        ]
      }
    },
    "exeName": {
      "type": "generated",
      "generator": "coalesce",
      "replaces": "GAME_EXE",
      "parameters": {
        "sourceVariableName": "exe",
        "fallbackVariableName": "exeDefault"
      }
    },
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "COPYRIGHT_YEAR",
      "parameters": {
        "format": "yyyy"
      }
    }
  },
  "SpecialCustomOperations": {
    "**/*.sh": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "#if"
            ],
            "else": [
              "#else"
            ],
            "elseif": [
              "#elif"
            ],
            "endif": [
              "#endif"
            ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.toml": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "#if"
            ],
            "else": [
              "#else"
            ],
            "elseif": [
              "#elif"
            ],
            "endif": [
              "#endif"
            ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "#if"
            ],
            "else": [
              "#else"
            ],
            "elseif": [
              "#elif"
            ],
            "endif": [
              "#endif"
            ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!mono)",
          "exclude": [
            ".github/**"
          ]
        }
      ]
    }
  ]
}
