{
  "$schema": "http://json.schemastore.org/template",
  "author": "Astra",
  "classifications": [
    "Astra",
    "BepInEx",
    "Unity",
    "Mod"
  ],
  "identity": "Astra.Unity.Integration",
  "name": "Astra game integration (BepInEx)",
  "shortName": "astra-integration",
  "sourceName": "AstraIntegration",
  "preferNameDirectory": true,
  "forms": {
    "noBackslash": {
      "identifier": "replace",
      "pattern": "\\\\",
      "replacement": ""
    },
    "noQuote": {
      "identifier": "replace",
      "pattern": "\"",
      "replacement": "'"
    },
    "noControl": {
      "identifier": "replace",
      "pattern": "[\\x00-\\x1f\\x7f]",
      "replacement": ""
    },
    "codeSafe": {
      "identifier": "chain",
      "steps": [
        "noBackslash",
        "noQuote",
        "noControl"
      ]
    },
    "xml": {
      "identifier": "xmlEncode"
    },
    "codeSafeXml": {
      "identifier": "chain",
      "steps": [
        "codeSafe",
        "xml"
      ]
    },
    "slashes": {
      "identifier": "replace",
      "pattern": "\\\\",
      "replacement": "/"
    },
    "exeSafe": {
      "identifier": "chain",
      "steps": [
        "slashes",
        "noQuote",
        "noControl"
      ]
    }
  },
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "game": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "replaces": "GAME_NAME",
      "description": "The game's name as players know it (\"PEAK\"). In code and manifests a \" becomes ' and a \\ is dropped."
    },
    "id": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "astra.my-game",
      "description": "The integration's id: its BepInEx GUID and its marketplace id (\"astra.peak\"). It must match ^[A-Za-z0-9][A-Za-z0-9._-]*$: anything else is refused and nothing is written.",
      "replaces": "astra.integration-id"
    },
    "runtime": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "mono",
      "choices": [
        {
          "choice": "mono",
          "description": "A Mono game (<Game>_Data/Managed/Assembly-CSharp.dll exists): BepInEx 5."
        },
        {
          "choice": "il2cpp",
          "description": "An IL2CPP game (GameAssembly.dll exists): BepInEx 6."
        }
      ]
    },
    "steamAppId": {
      "type": "parameter",
      "datatype": "integer",
      "isRequired": true,
      "replaces": "0000000",
      "description": "The game's Steam app id (its store page URL has it). Astra keys the game's profile on it."
    },
    "gameDir": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Where the game is installed (its assemblies are referenced to compile, never shipped)."
    },
    "owner": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "your-github-name",
      "description": "The GitHub user or organisation that will own this repository: its address in astra-gi.toml, the author and the LICENSE's copyright. It must match ^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$ (a GitHub name): anything else is refused and nothing is written.",
      "replaces": "GITHUB_OWNER"
    },
    "exe": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "The game's executable, relative to its folder (default: <game>.exe). A \\ becomes /, a \" becomes '."
    },
    "mono": {
      "type": "computed",
      "value": "(runtime == \"mono\")"
    },
    "runtimeName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "RUNTIME_NAME",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(runtime == 'mono')",
            "value": "unity-mono"
          },
          {
            "condition": "(runtime == 'il2cpp')",
            "value": "unity-il2cpp"
          }
        ]
      }
    },
    "loaderName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "LOADER_NAME",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(runtime == 'mono')",
            "value": "bepinex5"
          },
          {
            "condition": "(runtime == 'il2cpp')",
            "value": "bepinex6"
          }
        ]
      }
    },
    "idValid": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "id",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "ownerValid": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "owner",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
      }
    },
    "gameStr": {
      "type": "derived",
      "valueSource": "game",
      "valueTransform": "codeSafe",
      "replaces": "STR_GAME"
    },
    "gameXml": {
      "type": "derived",
      "valueSource": "game",
      "valueTransform": "codeSafeXml",
      "replaces": "XML_GAME"
    },
    "gameDirXml": {
      "type": "derived",
      "valueSource": "gameDir",
      "valueTransform": "xml",
      "replaces": "GAME_DIR_PATH"
    },
    "exeDefault": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "gameStr"
          },
          {
            "type": "const",
            "value": ".exe"
          }
        ]
      }
    },
    "exeName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "exe",
        "fallbackVariableName": "exeDefault"
      }
    },
    "exeStr": {
      "type": "derived",
      "valueSource": "exeName",
      "valueTransform": "exeSafe",
      "replaces": "GAME_EXE"
    },
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "COPYRIGHT_YEAR",
      "parameters": {
        "format": "yyyy"
      }
    }
  },
  "SpecialCustomOperations": {
    "**/*.sh": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "#if"
            ],
            "else": [
              "#else"
            ],
            "elseif": [
              "#elif"
            ],
            "endif": [
              "#endif"
            ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.toml": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "#if"
            ],
            "else": [
              "#else"
            ],
            "elseif": [
              "#elif"
            ],
            "endif": [
              "#endif"
            ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "#if"
            ],
            "else": [
              "#else"
            ],
            "elseif": [
              "#elif"
            ],
            "endif": [
              "#endif"
            ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!mono)",
          "exclude": [
            ".github/**"
          ]
        },
        {
          "condition": "(!idValid || !ownerValid)",
          "exclude": [
            "**/*"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "condition": "(!idValid)",
      "description": "REFUSED: nothing was written.",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": false,
      "manualInstructions": [
        {
          "text": "--id is not an integration id: it must match ^[A-Za-z0-9][A-Za-z0-9._-]*$ (letters, digits, '.', '_', '-'; e.g. astra.peak). Run dotnet new again with a valid one."
        }
      ]
    },
    {
      "condition": "(!ownerValid)",
      "description": "REFUSED: nothing was written.",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": false,
      "manualInstructions": [
        {
          "text": "--owner is not a GitHub user or organisation name: it must match ^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$. Run dotnet new again with a valid one."
        }
      ]
    }
  ]
}
