<Project Sdk="Microsoft.NET.Sdk">
  <!-- The chain loader (design: gi-bugs/unity-mods-design.md §4.3). Doorstop points at this DLL
       instead of BepInEx's own preloader when the launcher plays "with mods": it hands the process
       to the PLAYER's own BepInEx preloader (so their pack's patched entrypoint, semver plugins,
       legacy Harmony etc. all run exactly as their own manager would run them), then installs
       Astra.Chain.Hooks.dll so Astra's plugins are discovered alongside theirs.

       net35, mscorlib (+ the always-present System/System.Core BCL) ONLY: no BepInEx, no Harmony, no
       project reference to Astra.Chain.Hooks. It must load and run correctly in the EARLIEST possible
       Mono state, before anything else is known to exist — referencing Hooks (which itself binds to
       BepInEx/HarmonyX) would be a dependency this assembly can never carry. Astra.Chain.Hooks.dll is
       reached only via Assembly.LoadFrom + reflection, after their preloader has already run. -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>Astra.Chain</AssemblyName>
    <RootNamespace>Astra.Chain</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Doorstop 3's native loader finds our Main the same way BepInEx finds a plugin's own entry: a
         Mono method-desc search over the image's metadata table, not the PE/CorFlags entry-point
         token — so this stays an ordinary class library (no <OutputType>Exe</OutputType> trick). -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference assemblies only (compile-time facades for net35); nothing is restored or shipped
         at runtime beyond what Mono/.NET Framework already carries. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
